[Unit]
Description=PMLDL complete ML pipeline every five minutes

[Service]
Type=simple
# Render these placeholders with: python scripts/install_service.py
WorkingDirectory=@WORKDIR@
ExecStart=@PYTHON@ @SCRIPT@ schedule --interval 300
Restart=on-failure
RestartSec=15
KillMode=control-group
TimeoutStopSec=45

[Install]
WantedBy=default.target
